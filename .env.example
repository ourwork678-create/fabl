# নমুনা কনফিগারেশন — এই ফাইলটা `.env` নামে কপি করে আসল মান বসান।
# `.env` কখনো গিটে কমিট হয় না।

# ===== ডেটাবেস (PostgreSQL / Supabase) =====
# অ্যাপ চালানোর সময় ব্যবহৃত — Supabase এর "Connection pooling" URL (পোর্ট 6543)
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# মাইগ্রেশনের জন্য — Supabase এর ডাইরেক্ট URL (পোর্ট 5432)
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ===== NextAuth =====
# শক্তিশালী র‍্যান্ডম স্ট্রিং। তৈরি করতে: npx auth secret
NEXTAUTH_SECRET="change-me-to-a-strong-secret"

# সাইটের ঠিকানা — https সহ, শেষে স্ল্যাশ ছাড়া।
# লোকালে: http://localhost:3000
# Vercel-এ: https://your-project.vercel.app (বা কাস্টম ডোমেইন)
NEXTAUTH_URL="http://localhost:3000"

# ===== IoT/সেন্সর পুশ API কী (/api/monitoring POST, x-api-key হেডার) =====
MONITORING_API_KEY="change-me-to-a-strong-key"

# ===== শুধু প্রথমবার মালিকের অ্যাকাউন্ট বানাতে (npm run db:seed) =====
# না দিলে স্ক্রিপ্ট টার্মিনালেই জিজ্ঞেস করবে। কাজ শেষে লাইন দুটো মুছে ফেলুন।
# OWNER_EMAIL="owner@example.com"
# OWNER_PASSWORD="অন্তত-১০-অক্ষরের-পাসওয়ার্ড"
